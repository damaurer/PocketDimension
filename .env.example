# Copy to .env for local development (npm run dev) or pass to `docker run --env-file`.

# Required in production: random string of at least 32 characters.
# Generate one with: openssl rand -base64 48
SECRET_JWT_KEY=

# Initial administrator, created on first start if the email does not exist yet.
DB_ADMIN_USER=admin
DB_ADMIN_EMAIL=admin@example.com
DB_ADMIN_PASSWORD=

# Where the SQLite database lives (mount this directory as a volume).
DB_PATH=shared/pocketdimension.db

# How long a login stays valid, in seconds (default: 1 day).
# SESSION_MAX_AGE_SECONDS=86400

# Docker API. Defaults to the local socket. Point this at a docker-socket-proxy
# to limit what PocketDimension may do, e.g. tcp://docker-proxy:2375
# DOCKER_HOST=

# Behind a reverse proxy: the public URL, and the header carrying the client IP
# so that login rate limiting sees real addresses.
# ORIGIN=https://games.example.com
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
