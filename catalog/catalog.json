{
	"schemaVersion": 1,
	"games": [
		{
			"version": 1,
			"slug": "7-days-to-die",
			"name": "7 Days to Die",
			"description": "Zombie survival with base building. Downloads about 15 GB on first start. Server name and password are set in serverfiles/sdtdserver.xml.",
			"image": "vinanrra/7dtd-server:latest",
			"ports": [
				{
					"container": 26900,
					"protocol": "tcp",
					"label": "Game (TCP)"
				},
				{
					"container": 26900,
					"protocol": "udp",
					"label": "Game"
				},
				{
					"container": 26901,
					"protocol": "udp",
					"label": "Query"
				},
				{
					"container": 26902,
					"protocol": "udp",
					"label": "Game 2"
				}
			],
			"env": [
				{
					"key": "START_MODE",
					"label": "Start mode (1 start, 3 update and start)",
					"default": "3",
					"required": true,
					"options": [
						"1",
						"3"
					]
				},
				{
					"key": "VERSION",
					"label": "Game branch",
					"default": "stable"
				},
				{
					"key": "TimeZone",
					"label": "Time zone",
					"default": "Europe/Berlin"
				}
			],
			"volumes": [
				{
					"container": "/home/sdtdserver/serverfiles"
				},
				{
					"container": "/home/sdtdserver/.local/share/7DaysToDie"
				},
				{
					"container": "/home/sdtdserver/lgsm/config-lgsm/sdtdserver"
				},
				{
					"container": "/home/sdtdserver/log"
				},
				{
					"container": "/home/sdtdserver/lgsm/backup"
				}
			],
			"memoryMb": 8192,
			"query": {
				"type": "sdtd",
				"port": 2
			},
			"docsUrl": "https://github.com/vinanrra/Docker-7DaysToDie"
		},
		{
			"version": 1,
			"slug": "ark-survival-evolved",
			"name": "ARK: Survival Evolved",
			"description": "Dinosaur survival. Downloads about 20 GB on first start, which takes a while. Not ARK: Survival Ascended.",
			"image": "hermsi/ark-server:latest",
			"ports": [
				{
					"container": 7777,
					"protocol": "udp",
					"label": "Game"
				},
				{
					"container": 7778,
					"protocol": "udp",
					"label": "Game 2"
				},
				{
					"container": 27015,
					"protocol": "udp",
					"label": "Query"
				}
			],
			"env": [
				{
					"key": "SESSION_NAME",
					"label": "Server name",
					"default": "PocketDimension",
					"required": true
				},
				{
					"key": "SERVER_MAP",
					"label": "Map",
					"default": "TheIsland",
					"options": [
						"TheIsland",
						"TheCenter",
						"ScorchedEarth_P",
						"Ragnarok",
						"Aberration_P",
						"Extinction",
						"Valguero_P",
						"Genesis",
						"CrystalIsles",
						"Gen2",
						"LostIsland",
						"Fjordur"
					]
				},
				{
					"key": "SERVER_PASSWORD",
					"label": "Server password",
					"required": true,
					"secret": true
				},
				{
					"key": "ADMIN_PASSWORD",
					"label": "Admin password",
					"required": true,
					"secret": true
				},
				{
					"key": "MAX_PLAYERS",
					"label": "Max players",
					"default": "20"
				},
				{
					"key": "UPDATE_ON_START",
					"label": "Update on every start",
					"default": "true",
					"options": [
						"false",
						"true"
					]
				}
			],
			"volumes": [
				{
					"container": "/app"
				}
			],
			"memoryMb": 8192,
			"query": {
				"type": "ase",
				"port": 2
			},
			"docsUrl": "https://github.com/Hermsi1337/docker-ark-server"
		},
